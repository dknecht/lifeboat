{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lifeboat",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lifeboat",
      // Replace with the ID printed by `wrangler d1 create lifeboat`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MAIL", "bucket_name": "lifeboat-mail" }],
  "send_email": [{ "name": "EMAIL" }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    // The mail domain Lifeboat covers, e.g. "example.com".
    "MAIL_DOMAIN": "example.com",
    // Public URL of this Worker, used in invite links.
    "APP_URL": "http://localhost:8787",
    // "manual": show DNS instructions. "api": change DNS through the Cloudflare API (experimental).
    "DNS_MODE": "manual",
    // "hold": keep mail for unknown recipients for admin review. "reject": refuse it.
    "UNKNOWN_RECIPIENT": "hold",
    "AUTO_FAILOVER": "false",
    "PROBE_THRESHOLD": "3",
    "RETENTION_DAYS": "30",
    // Microsoft Entra app registration (client credentials). Leave empty to disable Graph features.
    "GRAPH_TENANT_ID": "",
    "GRAPH_CLIENT_ID": "",
    "GRAPH_CANARY_MAILBOX": "",
    // Needed only for DNS_MODE "api".
    "CF_ZONE_ID": ""
  }
  // Secrets (set with `wrangler secret put`): ADMIN_TOKEN, GRAPH_CLIENT_SECRET, CF_API_TOKEN
}
