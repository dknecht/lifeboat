# Copy to .env for local development. For deploys, set these in the environment or your CI secrets.

# Required
MAIL_DOMAIN=example.com
APP_URL=http://localhost:1337
ADMIN_TOKEN=change-me-to-a-long-random-string

# Microsoft Entra app registration (client credentials). Leave unset to disable Graph features.
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# GRAPH_CANARY_MAILBOX=

# Sign-in. "local": Lifeboat passwords. "access": Cloudflare Access only.
# "both": Lifeboat passwords for mail, with the admin console requiring Access.
# AUTH_MODE=local
# ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# ACCESS_AUD=
# ACCESS_ADMIN_EMAILS=
# ACCESS_ADMIN_SERVICE_TOKENS=

# Set either of these and the deploy puts Cloudflare Access in front of the Worker and the landing page.
# ACCESS_ALLOW_EMAILS=
# ACCESS_ALLOW_DOMAINS=

# Behaviour (defaults shown)
# DNS_MODE=manual
# UNKNOWN_RECIPIENT=hold
# AUTO_FAILOVER=false
# PROBE_THRESHOLD=3
# RETENTION_DAYS=30
# DIRECTORY_SYNC_HOURS=24   (0 turns the scheduled directory import off)

# Only for DNS_MODE=api
# CF_ZONE_ID=
# CF_API_TOKEN=
