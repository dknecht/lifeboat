# Copy to .env for local development. For deploys, set these in the environment or your CI secrets.

# Required
MAIL_DOMAIN=example.com
APP_URL=http://localhost:1337
ADMIN_TOKEN=change-me-to-a-long-random-string

# Microsoft Entra app registration (client credentials). Leave unset to disable Graph features.
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# GRAPH_CANARY_MAILBOX=

# Behaviour (defaults shown)
# DNS_MODE=manual
# UNKNOWN_RECIPIENT=hold
# AUTO_FAILOVER=false
# PROBE_THRESHOLD=3
# RETENTION_DAYS=30

# Only for DNS_MODE=api
# CF_ZONE_ID=
# CF_API_TOKEN=
